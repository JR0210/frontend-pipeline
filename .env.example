# ── Vercel v0 API ────────────────────────────────────────────────────────────
# Required to call the v0 code-generation API (npm run dev -- generate --prompt)
V0_API_KEY=your_v0_api_key_here

# Optional: override the v0 API base URL (useful for local mocking/tests)
# V0_API_BASE_URL=https://v0.dev/api

# ── Feature flags ─────────────────────────────────────────────────────────────
# Each flag defaults to true. Set to false to disable.
# PIPELINE_FLAG_ENABLE_V0_INTEGRATION=true
# PIPELINE_FLAG_ENABLE_SKILLS_ENGINE=true
# PIPELINE_FLAG_ENABLE_TEST_GENERATION=true
# PIPELINE_FLAG_ENABLE_ERROR_BOUNDARIES=true
# PIPELINE_FLAG_ENABLE_STRUCTURED_LOGGING=false
# PIPELINE_FLAG_ENABLE_OBSERVABILITY=true

# ── Runtime ───────────────────────────────────────────────────────────────────
# Enables structured JSON logging (auto-set in production)
# NODE_ENV=development
